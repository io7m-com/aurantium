<?xml version="1.0" encoding="UTF-8" ?>

<Section title="JSON Expressions"
         xmlns="urn:com.io7m.structural:8:0"
         xmlns:xi="http://www.w3.org/2001/XInclude">

  <Subsection title="Overview">
    <Paragraph>
      The <Term type="package">aurantium</Term> binary encoding embeds
      <LinkExternal target="https://www.json.org/">JSON</LinkExternal>
      text into the file format for complex structured data. This section of the
      specification defines a formal model for JSON expressions, and describes
      how those expressions are converted to text.
    </Paragraph>
  </Subsection>

  <Subsection title="Expressions"
              id="9f50e748-1651-4ac3-944b-909267e4ec03">
    <Paragraph>
      A <Term type="term">JSON expression</Term> is a value of the
      <Term type="type">json</Term>
      type:
    </Paragraph>
    <FormalItem title="JSON Expression"
                id="101776b7-f581-4ad0-8016-c16ac802040e">
      <Verbatim>
        <xi:include href="18000.txt"
                    parse="text"/>
      </Verbatim>
    </FormalItem>
    <Paragraph>
      An expression <Term type="expression">JsonBoolean b</Term> represents a
      boolean constant <Term type="expression">b</Term>.
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JsonInteger n</Term> represents an
      integer constant <Term type="expression">n</Term>.
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JsonFloat</Term> represents a
      floating-point constant
      <LinkFootnote target="cd1b1818-7e47-4830-92ac-a27a1ac826cf"/>.
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JsonString s</Term> represents a
      string constant <Term type="expression">s</Term>.
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JsonObject o</Term> represents a
      JSON object with properties <Term type="expression">o</Term>.
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JsonArray a</Term> represents a JSON
      array with values <Term type="expression">a</Term>.
    </Paragraph>
  </Subsection>

  <Subsection title="Tokens"
              id="5d92ab0c-fd17-4e2c-b7e3-06266459966e">
    <Paragraph>
      In order to serialize a
      <Link target="9f50e748-1651-4ac3-944b-909267e4ec03">JSON expression</Link>
      , we convert the expression to a sequence of
      <Term type="term">JSON tokens</Term>. A
      <Term type="term">JSON token</Term>
      is a value of type
      <Term type="type">jsonToken</Term>:
    </Paragraph>
    <FormalItem title="JSON Token"
                id="05b4e0aa-b262-49f6-a6a2-72944c1d5c87">
      <Verbatim>
        <xi:include href="18001.txt"
                    parse="text"/>
      </Verbatim>
    </FormalItem>
    <Paragraph>
      An expression <Term type="expression">JTTrue</Term> represents a boolean
      constant <Term type="expression">true</Term>.
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JTFalse</Term> represents a boolean
      constant <Term type="expression">false</Term> .
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JTInteger n</Term> represents an
      integer constant <Term type="expression">n</Term>.
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JTFloat</Term> represents a floating
      point constant
      <LinkFootnote target="cd1b1818-7e47-4830-92ac-a27a1ac826cf"/>.
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JTString s</Term> represents a
      string constant <Term type="expression">s</Term>.
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JTObjectStart</Term> represents a
      character constant <Term type="expression">{ U+007B</Term>.
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JTObjectEnd</Term> represents a
      character constant <Term type="expression">} U+007D</Term>.
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JTColon</Term> represents a
      character constant <Term type="expression">: U+003A</Term>.
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JTComma</Term> represents a
      character constant <Term type="expression">, U+002C</Term>.
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JTArrayStart</Term> represents a
      character constant <Term type="expression">[ U+005B</Term>.
    </Paragraph>
    <Paragraph>
      An expression <Term type="expression">JTArrayEnd</Term> represents a
      character constant <Term type="expression">] U+005D</Term>.
    </Paragraph>
  </Subsection>

